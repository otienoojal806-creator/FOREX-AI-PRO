# ForexAI Scalper engine. Copy to .env on the Windows VPS. NEVER commit the real file.
# The engine is OUTBOUND ONLY: it polls Supabase for dashboard commands and pushes state. No inbound ports are needed.

# --- Supabase (the service-role key stays on the VPS; the browser never sees it) ---
SUPABASE_URL=https://mywpsrnxixwvypjgubjj.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# auth.users uuid of the account that bought the Automated Trading module
ENGINE_USER_ID=

# --- MetaTrader 5 terminal (already installed and logged in on this machine) ---
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
# The account number you EXPECT. The engine refuses to trade any other account.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# --- Hard safety switches (the dashboard can never override these) ---
# Keep false until demo tests pass. true lets you ARM live trading from the phone.
ENGINE_ALLOW_LIVE=false
# Second switch, needed in addition to the one above for a REAL (non-demo) account.
ENGINE_ALLOW_REAL_ACCOUNT=false
HARD_MAX_RISK_PER_TRADE_PCT=1.0
HARD_MAX_DAILY_LOSS_PCT=5.0
HARD_MAX_TOTAL_POSITIONS=5

# --- Phone alerts via Telegram: create a bot with @BotFather, message it once, then read your chat id ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Lets ONLY that private chat send /status /positions /today /pause /stop. It can never resume, arm live or close trades.
TELEGRAM_CONTROL=true

# --- Dead-man's switch: create a free check at healthchecks.io (period 2 min, grace 3 min), paste its ping URL.
# The engine pings it only while healthy, so you get a phone alert if the VPS, MT5 or the engine dies or hangs. ---
HEALTHCHECK_PING_URL=

# --- Local ops API (read-only /health and /status). Binds to localhost unless you change it. ---
ENGINE_API_HOST=127.0.0.1
ENGINE_API_PORT=8765
# Long random string; enables /status
ENGINE_API_TOKEN=

LOG_LEVEL=INFO
ENGINE_STATE_DIR=.\state
